# ─── Database ────────────────────────────────────────────────────────────────
# Local Docker (docker-compose up -d):
DATABASE_URL="postgresql://inculcate:inculcate@localhost:5432/inculcate?schema=public"
# Or a hosted Postgres (Neon/Supabase free tier) — paste their connection string:
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ─── Auth.js (NextAuth v5) ─────────────────────────────────────────────────────
# Generate: `npx auth secret`  (or any 32+ char random string)
AUTH_SECRET="change-me-to-a-long-random-string"
# Base URL of the app
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ─── PII encryption at rest ────────────────────────────────────────────────────
# 32-byte key, base64-encoded. Generate: `openssl rand -base64 32`
PII_ENCRYPTION_KEY="change-me-32-byte-base64-key="

# ─── AI layer (Epic 3+) — server-side only, never expose to client ─────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"

# ─── Stubbed integrations (Epic 5+) — swappable behind interfaces ──────────────
STORAGE_PROVIDER="local"            # local | s3
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

NOTIFICATION_EMAIL_PROVIDER="stub"  # stub | resend | ses
NOTIFICATION_SMS_PROVIDER="stub"    # stub | twilio
NOTIFICATION_WHATSAPP_PROVIDER="stub"

# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV="development"
